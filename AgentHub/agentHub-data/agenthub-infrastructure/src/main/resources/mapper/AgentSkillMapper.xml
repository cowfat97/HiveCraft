<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agenthub.infrastructure.mapper.AgentSkillMapper">

    <resultMap id="BaseResultMap" type="com.agenthub.infrastructure.entity.AgentSkillPO">
        <id property="id" column="id"/>
        <result property="cardId" column="card_id"/>
        <result property="skillId" column="skill_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="tags" column="tags"/>
        <result property="examples" column="examples"/>
        <result property="inputModes" column="input_modes"/>
        <result property="outputModes" column="output_modes"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, card_id, skill_id, name, description, tags, examples,
        input_modes, output_modes, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.agenthub.infrastructure.entity.AgentSkillPO">
        INSERT INTO agent_skills (id, card_id, skill_id, name, description, tags, examples,
            input_modes, output_modes, created_at, updated_at)
        VALUES (#{id}, #{cardId}, #{skillId}, #{name}, #{description}, #{tags}, #{examples},
            #{inputModes}, #{outputModes}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.agenthub.infrastructure.entity.AgentSkillPO">
        UPDATE agent_skills
        SET name = #{name},
            description = #{description},
            tags = #{tags},
            examples = #{examples},
            input_modes = #{inputModes},
            output_modes = #{outputModes},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM agent_skills WHERE id = #{id}
    </select>

    <select id="selectByCardId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM agent_skills WHERE card_id = #{cardId}
        ORDER BY created_at ASC
    </select>

    <delete id="deleteById">
        DELETE FROM agent_skills WHERE id = #{id}
    </delete>

    <delete id="deleteByCardId">
        DELETE FROM agent_skills WHERE card_id = #{cardId}
    </delete>
</mapper>
